// Déploiement sur Cloudflare (Workers, fichiers statiques) : le site est servi tel quel, sans compilation.
{
  "name": "colle-express",
  "compatibility_date": "2026-11-01",
  // Adresse publique gratuite : https://colle-express.<compte>.workers.dev
  "workers_dev": true,
  "assets": {
    "directory": "./",
    "not_found_handling": "single-page-application"
  }
}
